rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Règles pour les images de profil
    match /profiles/{userId}/{allPaths=**} {
      // Seul l'utilisateur concerné peut téléverser sa photo de profil
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Tout le monde peut lire les photos de profil (public)
      allow read: if true;
    }
    
    // Règles pour les images des lieux
    match /lieux/{lieuId}/{allPaths=**} {
      // Les utilisateurs connectés peuvent téléverser des images de lieux
      allow write: if request.auth != null;
      
      // Tout le monde peut lire les images des lieux (public)
      allow read: if true;
    }
    
    // Règles pour les fichiers de contribution
    match /contributions/{contributionId}/{allPaths=**} {
      // L'utilisateur qui a créé la contribution peut téléverser des fichiers
      allow write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Les admins peuvent téléverser des fichiers pour n'importe quelle contribution
      allow write: if request.auth != null && 
        request.auth.token.role in ['admin', 'super_admin'];
      
      // Les admins peuvent lire tous les fichiers de contribution
      allow read: if request.auth != null && 
        request.auth.token.role in ['admin', 'super_admin'];
      
      // Le créateur peut lire ses propres fichiers
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Règles pour les documents administratifs
    match /admin/{allPaths=**} {
      // Seuls les admins peuvent accéder aux documents administratifs
      allow read, write: if request.auth != null && 
        request.auth.token.role in ['admin', 'super_admin'];
    }
    
    // Règles pour les fichiers temporaires
    match /temp/{userId}/{allPaths=**} {
      // Seul l'utilisateur concerné peut accéder à ses fichiers temporaires
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Suppression automatique après 24h (à implémenter dans les fonctions cloud)
    }
    
    // Règles pour les exports et backups
    match /exports/{allPaths=**} {
      // Seuls les super admins peuvent créer et lire les exports
      allow read, write: if request.auth != null && 
        request.auth.token.role == 'super_admin';
    }
  }
}
